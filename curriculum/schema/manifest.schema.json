{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudcaptain.io/schema/manifest.schema.json",
  "title": "CloudCaptain curriculum manifest",
  "type": "object",
  "required": ["version", "site", "phases", "paths"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "site": {
      "type": "object",
      "required": ["routeBasePath", "repo"],
      "properties": {
        "routeBasePath": { "type": "string", "pattern": "^/[a-z0-9-]+$" },
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "branch": { "type": "string" }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dir", "slug", "title", "tagline"],
        "additionalProperties": false,
        "properties": {
          "dir": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$", "description": "Folder under curriculum/phases/. The two-digit prefix is the stable phase number." },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "URL segment and the first half of every lesson id in this phase." },
          "title": { "type": "string", "maxLength": 40 },
          "icon": { "type": "string" },
          "tagline": { "type": "string", "maxLength": 160 }
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "lessons"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "careerPath": { "type": "string" },
          "lessons": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" } }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "referenceDoc"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "vendor": { "type": "string" },
          "referenceDoc": { "type": "string", "pattern": "^/docs/" },
          "phases": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
