apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ service_name }}
  labels:
    app.kubernetes.io/name: {{ service_name }}
spec:
  parentRefs:
    - name: public
      namespace: gateway-system
  hostnames:
    - {{ hostname }}
  rules:
    - backendRefs:
        - name: {{ service_name }}
          port: 80
