{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "platform.cloudcaptain.io/v1beta1",
      "kind": "Workload",
      "metadata": {
        "name": "both-scaling",
        "annotations": {
          "cc.test/expect": "set either replicas or min and max, not both",
          "cc.test/kubernetes": "reject"
        }
      },
      "spec": {
        "owner": "checkout",
        "container": {
          "image": "python:3.12-alpine",
          "command": [
            "python",
            "-m",
            "http.server",
            "8080"
          ],
          "port": 8080,
          "healthPath": "/",
          "env": [
            {
              "name": "LOG_LEVEL",
              "value": "info"
            }
          ]
        },
        "size": "small",
        "scaling": {
          "replicas": 2,
          "min": 2,
          "max": 4
        },
        "route": {
          "host": "shop.cc.test",
          "path": "/api/orders"
        },
        "dependencies": [
          {
            "name": "db",
            "type": "postgres"
          }
        ]
      }
    },
