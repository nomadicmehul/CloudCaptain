{
  "apiVersion": "platform.cloudcaptain.io/v1beta1",
  "kind": "Workload",
  "metadata": {
    "name": "orders"
  },
  "spec": {
    "owner": "checkout",
    "container": {
      "image": "python:3.12-alpine",
      "command": [
        "python",
        "-m",
        "http.server",
        "8080"
      ],
      "port": 8080,
      "healthPath": "/",
      "env": [
        {
          "name": "LOG_LEVEL",
          "value": "info"
        }
      ]
    },
    "size": "small",
    "scaling": {
      "min": 2,
      "max": 5,
      "targetCPUUtilization": 70
    },
    "route": {
      "host": "shop.cc.test",
      "path": "/api/orders"
    },
    "dependencies": [
      {
        "name": "db",
        "type": "postgres"
      }
    ]
  }
}
