    {
      "name": "same account: naming the account delegates to identity policies",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_principal.html",
      "principal": "arn:aws:iam::111122223333:user/exampleuser",
