{
  "scenarios": [
    {
      "name": "cross-account: Carlos and the production bucket",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic-cross-account.html",
      "principal": "arn:aws:sts::111111111111:assumed-role/Demo/carlos",
      "identity": [
        {
          "name": "role/Demo/demo-policy",
          "document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "AllowS3ListRead",
                "Effect": "Allow",
                "Action": "s3:ListAllMyBuckets",
                "Resource": "*"
              },
              {
                "Sid": "AllowS3ProductionObjectActions",
                "Effect": "Allow",
                "Action": "s3:*Object*",
                "Resource": "arn:aws:s3:::amzn-s3-demo-bucket-production/*"
              },
              {
                "Sid": "DenyS3Logs",
                "Effect": "Deny",
                "Action": "s3:*",
                "Resource": [
                  "arn:aws:s3:::*log*",
                  "arn:aws:s3:::*log*/*"
                ]
              }
            ]
          }
        }
      ],
      "resource_policy": {
        "name": "amzn-s3-demo-bucket-production bucket policy",
        "document": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject*",
                "s3:PutObject*",
                "s3:ReplicateObject",
                "s3:RestoreObject"
              ],
              "Principal": {
                "AWS": "arn:aws:iam::111111111111:role/Demo"
              },
              "Resource": "arn:aws:s3:::amzn-s3-demo-bucket-production/*"
            }
          ]
        }
      },
      "resource_account": "222222222222",
      "requests": [
        {
          "action": "s3:PutObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket-production/report.csv",
          "expect": "allowed",
          "expect_type": "identity",
          "expect_sid": "AllowS3ProductionObjectActions"
        },
        {
          "action": "s3:DeleteObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket-production/report.csv",
          "expect": "implicitDeny",
          "expect_type": "resource"
        },
        {
          "action": "s3:PutBucketPolicy",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket-production",
          "expect": "implicitDeny"
        }
      ]
    },
    {
      "name": "cross-account: the logs bucket matches DenyS3Logs",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic-cross-account.html",
      "principal": "arn:aws:sts::111111111111:assumed-role/Demo/carlos",
      "identity": [
        {
          "name": "role/Demo/demo-policy",
          "document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "AllowS3ListRead",
                "Effect": "Allow",
                "Action": "s3:ListAllMyBuckets",
                "Resource": "*"
              },
              {
                "Sid": "AllowS3ProductionObjectActions",
                "Effect": "Allow",
                "Action": "s3:*Object*",
                "Resource": "arn:aws:s3:::amzn-s3-demo-bucket-production/*"
              },
              {
                "Sid": "DenyS3Logs",
                "Effect": "Deny",
                "Action": "s3:*",
                "Resource": [
                  "arn:aws:s3:::*log*",
                  "arn:aws:s3:::*log*/*"
                ]
              }
            ]
          }
        }
      ],
      "resource_account": "222222222222",
      "requests": [
        {
          "action": "s3:PutObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket-production-logs/report.csv",
          "expect": "explicitDeny",
          "expect_type": "identity",
          "expect_sid": "DenyS3Logs"
        }
      ]
    },
    {
      "name": "Shirley: the boundary caps what identity policies grant",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies_boundaries.html",
      "principal": "arn:aws:iam::111122223333:user/Shirley",
      "boundary": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:*",
              "cloudwatch:*",
              "ec2:*"
            ],
            "Resource": "*"
          }
        ]
      },
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "iam:CreateUser",
              "Resource": "*"
            }
          ]
        }
      ],
      "requests": [
        {
          "action": "iam:CreateUser",
          "resource": "arn:aws:iam::111122223333:user/new-hire",
          "expect": "implicitDeny",
          "expect_type": "boundary"
        },
        {
          "action": "s3:ListAllMyBuckets",
          "resource": "*",
          "expect": "implicitDeny",
          "expect_type": "identity"
        }
      ]
    },
    {
      "name": "HRPayroll: Deny with NotResource grants nothing",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_notresource.html",
      "principal": "arn:aws:iam::111122223333:user/payroll-clerk",
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": "s3:*",
              "NotResource": [
                "arn:aws:s3:::HRBucket/Payroll",
                "arn:aws:s3:::HRBucket/Payroll/*"
              ]
            }
          ]
        }
      ],
      "requests": [
        {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::HRBucket/Payroll/june.csv",
          "expect": "implicitDeny",
          "expect_type": "identity"
        },
        {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::HRBucket/Marketing/plan.csv",
          "expect": "explicitDeny",
          "expect_type": "identity"
        }
      ]
    },
    {
      "name": "same account: a bucket policy naming the IAM user is enough",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic_policy-eval-denyallow.html",
      "principal": "arn:aws:iam::111122223333:user/exampleuser",
      "boundary": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "ec2:*",
            "Resource": "*"
          }
        ]
      },
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "BucketGrant",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:user/exampleuser"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::amzn-s3-demo-bucket/*"
          }
        ]
      },
      "requests": [
        {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket/doc.txt",
          "expect": "allowed",
          "expect_type": "resource"
        },
        {
          "action": "s3:PutObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket/doc.txt",
          "expect": "implicitDeny",
          "expect_type": "identity"
        }
      ]
    },
    {
      "name": "same account: a grant to the role ARN is limited by the boundary",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic_policy-eval-denyallow.html",
      "principal": "arn:aws:sts::111122223333:assumed-role/examplerole/examplerolesessionname",
      "boundary": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "ec2:*",
            "Resource": "*"
          }
        ]
      },
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "BucketGrant",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:role/examplerole"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::amzn-s3-demo-bucket/*"
          }
        ]
      },
      "requests": [
        {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket/doc.txt",
          "expect": "implicitDeny",
          "expect_type": "boundary"
        }
      ]
    },
    {
      "name": "same account: a grant to the role session ARN is not limited",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic_policy-eval-denyallow.html",
      "principal": "arn:aws:sts::111122223333:assumed-role/examplerole/examplerolesessionname",
      "boundary": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "ec2:*",
            "Resource": "*"
          }
        ]
      },
      "session": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ec2:DescribeInstances",
              "Resource": "*"
            }
          ]
        }
      ],
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "BucketGrant",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:sts::111122223333:assumed-role/examplerole/examplerolesessionname"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::amzn-s3-demo-bucket/*"
          }
        ]
      },
      "requests": [
        {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket/doc.txt",
          "expect": "allowed",
          "expect_type": "resource"
        }
      ]
    },
    {
      "name": "same account: a grant to the role ARN is limited by the session policy",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic_policy-eval-denyallow.html",
      "principal": "arn:aws:sts::111122223333:assumed-role/examplerole/examplerolesessionname",
      "session": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": "*"
            }
          ]
        }
      ],
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "BucketGrant",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:role/examplerole"
            },
            "Action": "s3:GetObject",
