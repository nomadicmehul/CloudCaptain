    {
      "name": "home directories with ${aws:username}",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html",
      "principal": "arn:aws:iam::111122223333:user/martha_rivera",
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetBucketLocation"
              ],
              "Resource": "arn:aws:s3:::*"
            },
            {
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": "arn:aws:s3:::amzn-s3-demo-bucket",
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    "",
                    "home/",
                    "home/${aws:username}/"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": "s3:*",
              "Resource": [
                "arn:aws:s3:::amzn-s3-demo-bucket/home/${aws:username}",
                "arn:aws:s3:::amzn-s3-demo-bucket/home/${aws:username}/*"
              ]
            }
          ]
        }
      ],
      "requests": [
        {
          "action": "s3:ListBucket",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket",
          "expect": "allowed",
          "context": {
            "s3:prefix": "home/martha_rivera/"
          }
        },
        {
          "action": "s3:ListBucket",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket",
          "expect": "allowed",
          "context": {
            "s3:prefix": ""
          }
        },
        {
          "action": "s3:ListBucket",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket",
          "expect": "implicitDeny",
          "context": {
            "s3:prefix": "home/nikki_wolf/"
          }
        },
        {
          "action": "s3:PutObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket/home/martha_rivera/notes.txt",
          "expect": "allowed"
        },
        {
          "action": "s3:PutObject",
          "resource": "arn:aws:s3:::amzn-s3-demo-bucket/home/nikki_wolf/notes.txt",
          "expect": "implicitDeny"
        }
      ]
    },
