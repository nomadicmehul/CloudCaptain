      ],
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Deny",
            "Principal": {
              "AWS": "arn:aws:iam::123456789012:user/John"
            },
            "Action": "secretsmanager:GetSecretValue",
            "Resource": "*"
          }
        ]
      },
      "requests": [
        {
          "action": "secretsmanager:GetSecretValue",
          "resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:*",
          "expect": "explicitDeny",
          "expect_type": "resource",
          "expect_message": "User: arn:aws:iam::123456789012:user/John is not authorized to perform: secretsmanager:GetSecretValue on resource: arn:aws:secretsmanager:us-east-1:123456789012:secret:* with an explicit deny in a resource-based policy"
        }
      ]
