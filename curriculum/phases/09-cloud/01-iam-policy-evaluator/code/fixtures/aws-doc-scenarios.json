    {
      "name": "John: an RCP denies the secret",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/troubleshoot_access-denied.html",
      "principal": "arn:aws:iam::123456789012:user/John",
      "identity": [
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "secretsmanager:*",
              "Resource": "*"
            }
          ]
        }
      ],
      "rcps": [
        [
          {
            "name": "RCPFullAWSAccess",
            "document": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Principal": "*",
                  "Action": "*",
                  "Resource": "*"
                }
              ]
            }
          },
          {
            "name": "DenySecrets",
            "document": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Deny",
                  "Principal": "*",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      ],
      "requests": [
        {
          "action": "secretsmanager:GetSecretValue",
          "resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:*",
          "expect": "explicitDeny",
          "expect_type": "rcp",
          "expect_message": "User: arn:aws:iam::123456789012:user/John is not authorized to perform: secretsmanager:GetSecretValue on resource: arn:aws:secretsmanager:us-east-1:123456789012:secret:* with an explicit deny in a resource control policy"
        }
      ]
    },
    {
      "name": "John: the secret's resource policy denies",
      "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/troubleshoot_access-denied.html",
      "principal": "arn:aws:iam::123456789012:user/John",
      "identity": [
