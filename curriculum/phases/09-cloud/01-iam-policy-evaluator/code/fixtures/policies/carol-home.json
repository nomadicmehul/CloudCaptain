{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnHome",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::cc-data/home/${aws:username}/*"
    },
    {
      "Sid": "ListOwnHome",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cc-data",
      "Condition": {"StringLike": {"s3:prefix": ["home/${aws:username}/*"]}}
    }
  ]
}
