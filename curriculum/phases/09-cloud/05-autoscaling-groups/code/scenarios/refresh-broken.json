{
  "description": "instance refresh to a version that never passes the load balancer check: ELB health checks stop it at one instance, EC2 checks let it finish",
  "group": {
    "AutoScalingGroupName": "web",
    "AvailabilityZones": [
      "us-east-1a",
      "us-east-1b",
      "us-east-1c"
    ],
    "MinSize": 2,
    "MaxSize": 8,
    "DesiredCapacity": 4,
    "HealthCheckType": "ELB",
    "HealthCheckGracePeriod": 60,
    "DefaultInstanceWarmup": 120,
    "BrokenVersions": [
      "3"
    ]
  },
  "events": [
    {
      "at": 600,
      "op": "start-instance-refresh",
      "Version": "3",
      "Preferences": {
        "MinHealthyPercentage": 90
      }
    }
  ],
  "until": 5400
}
