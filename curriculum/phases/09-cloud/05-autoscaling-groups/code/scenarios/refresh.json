{
  "description": "instance refresh with MinHealthyPercentage 90 on 4 instances: terminate one, launch one, wait for health and warmup, repeat",
  "group": {
    "AutoScalingGroupName": "web",
    "AvailabilityZones": [
      "us-east-1a",
      "us-east-1b",
      "us-east-1c"
    ],
    "MinSize": 2,
    "MaxSize": 8,
    "DesiredCapacity": 4,
    "HealthCheckType": "ELB",
    "HealthCheckGracePeriod": 60,
    "DefaultInstanceWarmup": 120
  },
  "events": [
    {
      "at": 600,
      "op": "start-instance-refresh",
      "Version": "2",
      "Preferences": {
        "MinHealthyPercentage": 90
      }
    }
  ],
  "until": 2400
}
