{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "db-allow",
    "namespace": "cc-network-policy"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "db"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "cc-network-policy-tools"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app": "api"
              }
            }
          }
        ],
        "ports": [
          {
            "port": "postgres"
          }
        ]
      }
    ]
  }
}
