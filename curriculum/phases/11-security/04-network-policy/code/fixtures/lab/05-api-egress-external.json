{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "api-egress-external",
    "namespace": "cc-network-policy"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "api"
      }
    },
    "policyTypes": [
      "Egress"
    ],
    "egress": [
      {
        "to": [
          {
            "ipBlock": {
              "cidr": "172.18.0.0/16",
              "except": [
                "172.18.0.12/32"
              ]
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8000,
            "endPort": 8099
          }
        ]
      }
    ]
  }
}
