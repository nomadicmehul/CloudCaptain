{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "api-allow-frontend",
    "namespace": "cc-network-policy"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "api"
      }
    },
    "ingress": [
      {
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "app": "frontend"
              }
            }
          }
        ],
        "ports": [
          {
            "port": "http"
          }
        ]
      }
    ]
  }
}
