{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "frontend-egress-api",
    "namespace": "cc-network-policy"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "frontend"
      }
    },
    "policyTypes": [
      "Egress"
    ],
    "egress": [
      {
        "to": [
          {
            "podSelector": {
              "matchLabels": {
                "app": "api"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": "http"
          }
        ]
      }
    ]
  }
}
