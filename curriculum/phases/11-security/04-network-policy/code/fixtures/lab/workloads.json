{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "frontend",
        "namespace": "cc-network-policy",
        "labels": {
          "app": "frontend"
        }
      },
      "spec": {
        "terminationGracePeriodSeconds": 1,
        "containers": [
          {
            "name": "main",
            "image": "python:3.12-alpine",
            "command": [
              "python3",
              "/opt/mininetpol/main.py",
              "serve",
              "--port",
              "8080",
              "--port",
              "9090",
              "--port",
              "5432"
            ],
            "ports": [
              {
                "name": "http",
                "containerPort": 8080,
                "protocol": "TCP"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "mininetpol",
                "mountPath": "/opt/mininetpol",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "mininetpol",
            "configMap": {
              "name": "mininetpol"
            }
          }
        ]
      }
    },
