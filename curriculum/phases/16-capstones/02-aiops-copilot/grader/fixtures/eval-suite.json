          "workload": "deployment/billing",
          "object": "pod/billing-6c9f7-k2x8q",
          "signal": "OOMKilled",
          "summary": "worker was OOMKilled (exit 137), limit 128Mi",
          "time": "2026-11-13T08:01:12Z",
          "data": {
            "exit_code": 137,
            "memory_limit": "128Mi"
          }
        },
        {
          "id": "pod/billing-6c9f7-k2x8q/worker/restarts",
          "kind": "restarts",
          "workload": "deployment/billing",
          "object": "pod/billing-6c9f7-k2x8q",
          "signal": "Restarts",
          "summary": "worker restarted 4 times",
          "time": null,
          "data": {
            "restart_count": 4
          }
        }
      ]
    },
