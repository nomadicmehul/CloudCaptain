{
  "title": "200 ms of delay and 5% loss on the API keeps p95 under 100 ms",
  "hypothesis": {
    "source": {"url": "http://127.0.0.1:9100/metrics"},
    "interval_s": 2,
    "min_requests": 10,
    "slis": [
      {"name": "error_rate", "type": "error_ratio", "errors": "minichaos_load_requests_total{outcome=\"error\"}", "total": "minichaos_load_requests_total", "max": 0.05},
      {"name": "p95_latency_s", "type": "latency_quantile", "histogram": "minichaos_load_request_duration_seconds{outcome=\"ok\"}", "quantile": 0.95, "max": 0.1}
    ],
    "recovery_s": 30
  },
  "method": {
    "duration_s": 60,
    "faults": [
      {"type": "netem", "netns": "cc-chaos-srv", "device": "cc-chaos-s", "delay_ms": 200, "loss_percent": 5}
    ]
  },
  "abort": {
    "rules": [
      {"sli": "p95_latency_s", "above": 0.15, "for": 2}
    ],
    "probe_errors": 3
  },
  "blast_radius": {"netns": ["cc-chaos-srv"], "max_duration_s": 120}
}
