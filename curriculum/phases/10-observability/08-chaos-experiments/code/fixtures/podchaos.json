  "metadata": {"name": "cc-web-pod-kill", "namespace": "cc-chaos-experiments"},
  "spec": {
    "action": "pod-kill",
    "mode": "one",
    "gracePeriod": 15,
    "selector": {"namespaces": ["cc-chaos-experiments"], "labelSelectors": {"app": "web"}}
  }
}
