{
  "global": {"scrape_interval": "2s", "scrape_timeout": "1s"},
  "scrape_configs": [
    {
      "job_name": "demo",
      "static_configs": [
        {"targets": ["127.0.0.1:18481", "127.0.0.1:18482"], "labels": {"env": "lab", "__meta_team": "payments"}},
        {"targets": ["127.0.0.1:9"], "labels": {"env": "skip"}}
      ],
      "relabel_configs": [
        {"source_labels": ["env"], "regex": "skip", "action": "drop"},
        {"action": "labelmap", "regex": "__meta_(.+)", "replacement": "$1"},
        {"source_labels": ["__address__"], "regex": ".*:(\\d+)", "target_label": "port", "replacement": "$1"}
      ],
      "metric_relabel_configs": [
        {"source_labels": ["__name__"], "regex": "cc_debug_.*", "action": "drop"}
      ]
    },
    {
      "job_name": "demo-honor",
      "honor_labels": true,
      "static_configs": [{"targets": ["127.0.0.1:18481"]}],
      "metric_relabel_configs": [
        {"source_labels": ["__name__"], "regex": "cc_build_info", "action": "keep"}
      ]
    }
  ]
}
