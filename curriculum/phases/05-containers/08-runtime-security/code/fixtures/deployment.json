{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {"name": "api", "namespace": "payments"},
  "spec": {
    "replicas": 3,
    "selector": {"matchLabels": {"app": "api"}},
    "template": {
      "metadata": {"labels": {"app": "api"}},
      "spec": {
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {"type": "RuntimeDefault"}
        },
        "initContainers": [
          {
            "name": "migrate",
            "image": "registry.example.com/api-migrate:2.4.1",
            "command": ["./migrate", "up"]
          }
        ],
        "containers": [
          {
            "name": "api",
            "image": "registry.example.com/api:2.4.1",
            "ports": [{"containerPort": 8080}],
            "securityContext": {
              "runAsUser": 10001,
              "capabilities": {"drop": ["ALL"], "add": ["NET_BIND_SERVICE"]}
            },
            "resources": {"limits": {"cpu": "500m", "memory": "256Mi"}, "requests": {"cpu": "100m", "memory": "128Mi"}}
          },
          {
            "name": "log-shipper",
            "image": "registry.example.com/shipper:1.9.0",
            "securityContext": {
              "runAsNonRoot": false,
              "runAsUser": 0,
              "allowPrivilegeEscalation": false,
              "seccompProfile": {"type": "Unconfined"},
              "capabilities": {"drop": ["ALL"], "add": ["SYS_PTRACE"]}
            },
            "volumeMounts": [{"name": "varlog", "mountPath": "/var/log"}]
          }
        ],
        "volumes": [
          {"name": "varlog", "hostPath": {"path": "/var/log"}},
          {"name": "cache", "emptyDir": {}}
        ]
      }
    }
  }
}
