{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {"name": "gpu", "namespace": "default", "labels": {"app": "gpu"}},
  "spec": {
    "nodeSelector": {"accelerator": "nvidia-l4"},
    "containers": [
      {"name": "infer", "image": "shop/infer:1.0", "resources": {"limits": {"nvidia.com/gpu": "1"}, "requests": {"cpu": "1", "memory": "4Gi"}}}
    ]
  }
}
