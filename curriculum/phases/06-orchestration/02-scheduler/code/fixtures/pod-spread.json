{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {"name": "api-3", "namespace": "default", "labels": {"app": "api"}},
  "spec": {
    "topologySpreadConstraints": [
      {"maxSkew": 1, "topologyKey": "kubernetes.io/hostname", "whenUnsatisfiable": "DoNotSchedule", "labelSelector": {"matchLabels": {"app": "api"}}}
    ],
    "containers": [
      {"name": "api", "image": "shop/api:2.3", "resources": {"requests": {"cpu": "500m", "memory": "512Mi"}}}
    ]
  }
}
