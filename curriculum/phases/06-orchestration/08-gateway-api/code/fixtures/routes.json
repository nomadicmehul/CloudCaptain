{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "Gateway",
      "metadata": {"name": "web", "namespace": "shop"},
      "spec": {
        "gatewayClassName": "eg",
        "listeners": [
          {"name": "http", "protocol": "HTTP", "port": 80, "hostname": "*.shop.test", "allowedRoutes": {"namespaces": {"from": "Same"}}}
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "blue", "namespace": "shop"},
      "spec": {"selector": {"app": "blue"}, "ports": [{"name": "http", "port": 8080, "targetPort": 8080}]}
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "green", "namespace": "shop"},
      "spec": {"selector": {"app": "green"}, "ports": [{"name": "http", "port": 8080, "targetPort": 8080}]}
    },
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "HTTPRoute",
      "metadata": {"name": "app", "namespace": "shop"},
      "spec": {
        "parentRefs": [{"name": "web"}],
        "hostnames": ["app.shop.test"],
        "rules": [
          {
            "matches": [{"path": {"type": "Exact", "value": "/api/health"}}],
            "filters": [{"type": "RequestHeaderModifier", "requestHeaderModifier": {"set": [{"name": "x-route", "value": "exact"}]}}],
            "backendRefs": [{"name": "green", "port": 8080}]
          },
          {
            "matches": [{"path": {"type": "PathPrefix", "value": "/api"}}],
            "backendRefs": [{"name": "blue", "port": 8080}]
          },
          {
            "matches": [{"path": {"type": "PathPrefix", "value": "/api"}, "headers": [{"name": "x-version", "value": "v2"}]}],
            "backendRefs": [{"name": "green", "port": 8080}]
          },
          {
            "matches": [{"path": {"type": "Exact", "value": "/old"}}],
            "filters": [{"type": "RequestRedirect", "requestRedirect": {"path": {"type": "ReplaceFullPath", "replaceFullPath": "/api/v1"}, "statusCode": 301}}]
          },
          {
            "matches": [{"path": {"type": "PathPrefix", "value": "/canary"}}],
            "backendRefs": [{"name": "blue", "port": 8080, "weight": 90}, {"name": "green", "port": 8080, "weight": 10}]
          },
          {
            "matches": [{"path": {"type": "PathPrefix", "value": "/v1"}}],
            "filters": [{"type": "URLRewrite", "urlRewrite": {"path": {"type": "ReplacePrefixMatch", "replacePrefixMatch": "/api"}}}],
            "backendRefs": [{"name": "blue", "port": 8080}]
          }
        ]
      }
    },
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "HTTPRoute",
      "metadata": {"name": "broken", "namespace": "shop"},
      "spec": {
        "parentRefs": [{"name": "web"}],
        "hostnames": ["app.shop.test"],
        "rules": [
          {"matches": [{"path": {"type": "PathPrefix", "value": "/broken"}}], "backendRefs": [{"name": "missing", "port": 8080}]}
        ]
      }
    },
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "HTTPRoute",
      "metadata": {"name": "elsewhere", "namespace": "shop"},
      "spec": {
        "parentRefs": [{"name": "web"}],
        "hostnames": ["other.example"],
        "rules": [
          {"backendRefs": [{"name": "blue", "port": 8080}]}
        ]
      }
    }
  ]
}
