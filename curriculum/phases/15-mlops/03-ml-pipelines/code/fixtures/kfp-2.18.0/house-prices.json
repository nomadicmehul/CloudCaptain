  "pipelineInfo": {
    "name": "house-prices"
  },
  "root": {
    "dag": {
      "tasks": {
        "condition-1": {
          "componentRef": {
            "name": "comp-condition-1"
          },
          "dependentTasks": [
            "evaluate-model",
            "train-model"
          ],
          "inputs": {
            "artifacts": {
              "pipelinechannel--train-model-model": {
                "taskOutputArtifact": {
                  "outputArtifactKey": "model",
                  "producerTask": "train-model"
                }
              }
            },
            "parameters": {
              "pipelinechannel--evaluate-model-Output": {
                "taskOutputParameter": {
                  "outputParameterKey": "Output",
                  "producerTask": "evaluate-model"
                }
              },
              "pipelinechannel--max_rmse": {
                "componentInputParameter": "max_rmse"
              }
            }
          },
          "taskInfo": {
            "name": "good-enough"
          },
          "triggerPolicy": {
            "condition": "inputs.parameter_values['pipelinechannel--evaluate-model-Output'] < inputs.parameter_values['pipelinechannel--max_rmse']"
          }
        },
        "evaluate-model": {
          "cachingOptions": {
            "enableCache": true
          },
          "componentRef": {
            "name": "comp-evaluate-model"
          },
          "dependentTasks": [
            "make-dataset",
            "train-model"
          ],
          "inputs": {
            "artifacts": {
              "model": {
                "taskOutputArtifact": {
                  "outputArtifactKey": "model",
                  "producerTask": "train-model"
                }
              },
              "test_data": {
                "taskOutputArtifact": {
                  "outputArtifactKey": "test_data",
                  "producerTask": "make-dataset"
                }
              }
            }
          },
          "taskInfo": {
            "name": "evaluate-model"
          }
        },
        "for-loop-3": {
          "componentRef": {
            "name": "comp-for-loop-3"
          },
          "dependentTasks": [
            "make-dataset",
            "train-model"
          ],
          "inputs": {
            "artifacts": {
              "pipelinechannel--make-dataset-test_data": {
                "taskOutputArtifact": {
                  "outputArtifactKey": "test_data",
                  "producerTask": "make-dataset"
                }
              },
              "pipelinechannel--train-model-model": {
                "taskOutputArtifact": {
                  "outputArtifactKey": "model",
                  "producerTask": "train-model"
                }
              }
            }
          },
          "iteratorPolicy": {
            "parallelismLimit": 2
          },
          "parameterIterator": {
            "itemInput": "pipelinechannel--loop-item-param-2",
            "items": {
              "raw": "[\"low\", \"mid\", \"high\"]"
            }
          },
          "taskInfo": {
            "name": "for-loop-3"
          }
        },
        "make-dataset": {
          "cachingOptions": {
            "enableCache": true
          },
          "componentRef": {
            "name": "comp-make-dataset"
          },
          "inputs": {
            "parameters": {
              "noise": {
                "componentInputParameter": "noise"
              },
              "rows": {
                "componentInputParameter": "rows"
              },
              "seed": {
                "componentInputParameter": "seed"
              }
            }
          },
          "taskInfo": {
            "name": "make-dataset"
          }
        },
        "train-model": {
          "cachingOptions": {
            "enableCache": true
          },
          "componentRef": {
            "name": "comp-train-model"
          },
          "dependentTasks": [
            "make-dataset"
          ],
          "inputs": {
            "artifacts": {
              "train_data": {
                "taskOutputArtifact": {
                  "outputArtifactKey": "train_data",
                  "producerTask": "make-dataset"
                }
              }
            },
            "parameters": {
              "epochs": {
                "componentInputParameter": "epochs"
              },
              "lr": {
                "componentInputParameter": "lr"
              }
            }
          },
          "retryPolicy": {
            "backoffDuration": "0s",
            "backoffFactor": 2.0,
            "backoffMaxDuration": "3600s",
            "maxRetryCount": 2
          },
          "taskInfo": {
            "name": "train-model"
          }
        }
      }
    },
    "inputDefinitions": {
      "parameters": {
        "epochs": {
          "defaultValue": 300.0,
          "isOptional": true,
          "parameterType": "NUMBER_INTEGER"
        },
        "lr": {
          "defaultValue": 0.5,
          "isOptional": true,
          "parameterType": "NUMBER_DOUBLE"
        },
        "max_rmse": {
          "defaultValue": 0.5,
          "isOptional": true,
          "parameterType": "NUMBER_DOUBLE"
        },
        "noise": {
          "defaultValue": 1.0,
          "isOptional": true,
          "parameterType": "NUMBER_DOUBLE"
        },
        "rows": {
          "defaultValue": 200.0,
          "isOptional": true,
          "parameterType": "NUMBER_INTEGER"
        },
        "seed": {
          "defaultValue": 7.0,
          "isOptional": true,
          "parameterType": "NUMBER_INTEGER"
        }
      }
    }
  },
  "schemaVersion": "2.1.0",
  "sdkVersion": "kfp-2.18.0"
}
