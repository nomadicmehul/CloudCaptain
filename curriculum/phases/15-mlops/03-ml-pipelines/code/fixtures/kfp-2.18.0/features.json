  "pipelineInfo": {
    "name": "features"
  },
  "root": {
    "dag": {
      "tasks": {
        "condition-1": {
          "componentRef": {
            "name": "comp-condition-1"
          },
          "dependentTasks": [
            "count"
          ],
          "inputs": {
            "parameters": {
              "pipelinechannel--count-Output": {
                "taskOutputParameter": {
                  "outputParameterKey": "Output",
                  "producerTask": "count"
                }
              }
            }
          },
          "taskInfo": {
            "name": "condition-1"
          },
          "triggerPolicy": {
            "condition": "int(inputs.parameter_values['pipelinechannel--count-Output']) == 1"
          }
        },
        "condition-2": {
          "componentRef": {
            "name": "comp-condition-2"
          },
          "inputs": {
            "parameters": {
              "pipelinechannel--mode": {
                "componentInputParameter": "mode"
              }
            }
          },
          "taskInfo": {
            "name": "fast-path"
          },
          "triggerPolicy": {
            "condition": "inputs.parameter_values['pipelinechannel--mode'] == 'fast'"
          }
        },
        "condition-7": {
          "componentRef": {
            "name": "comp-condition-7"
          },
          "dependentTasks": [
            "count-2"
          ],
          "inputs": {
            "parameters": {
              "pipelinechannel--count-2-Output": {
                "taskOutputParameter": {
                  "outputParameterKey": "Output",
                  "producerTask": "count-2"
                }
              },
              "pipelinechannel--k": {
                "componentInputParameter": "k"
              },
              "pipelinechannel--threshold": {
                "componentInputParameter": "threshold"
              }
            }
          },
          "taskInfo": {
            "name": "condition-7"
          },
          "triggerPolicy": {
            "condition": "inputs.parameter_values['pipelinechannel--threshold'] >= double(int(inputs.parameter_values['pipelinechannel--count-2-Output']))"
          }
        },
        "count": {
          "cachingOptions": {
            "enableCache": true
          },
          "componentRef": {
            "name": "comp-count"
          },
          "inputs": {
            "parameters": {
              "n": {
                "componentInputParameter": "k"
              }
            }
          },
          "taskInfo": {
            "name": "count"
          }
        },
        "count-2": {
          "cachingOptions": {},
          "componentRef": {
            "name": "comp-count-2"
          },
          "dependentTasks": [
            "count"
          ],
          "inputs": {
            "parameters": {
              "n": {
                "runtimeValue": {
                  "constant": 1.0
                }
              }
            }
          },
          "taskInfo": {
            "name": "count-2"
          }
        },
        "for-loop-4": {
          "componentRef": {
            "name": "comp-for-loop-4"
          },
          "iteratorPolicy": {
            "parallelismLimit": 1
          },
          "parameterIterator": {
            "itemInput": "pipelinechannel--loop-item-param-3",
            "items": {
              "raw": "[0.1, 0.2]"
            }
          },
          "taskInfo": {
            "name": "for-loop-4"
          }
        },
        "for-loop-6": {
          "componentRef": {
            "name": "comp-for-loop-6"
          },
          "parameterIterator": {
            "itemInput": "pipelinechannel--loop-item-param-5",
            "items": {
              "raw": "[1, 2]"
            }
          },
          "taskInfo": {
            "name": "for-loop-6"
          }
        }
      }
    },
    "inputDefinitions": {
      "parameters": {
        "k": {
          "defaultValue": 3.0,
          "isOptional": true,
          "parameterType": "NUMBER_INTEGER"
        },
        "mode": {
          "defaultValue": "fast",
          "isOptional": true,
          "parameterType": "STRING"
        },
        "threshold": {
          "defaultValue": 0.5,
          "isOptional": true,
          "parameterType": "NUMBER_DOUBLE"
        }
