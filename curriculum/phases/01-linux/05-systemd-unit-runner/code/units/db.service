[Unit]
Description=Demo database
After=network.target

[Service]
Type=simple
Environment=PGDATA=/tmp/cc-demo-db
ExecStartPre=/bin/sh -c 'echo "preparing $PGDATA"'
ExecStart=/bin/sh -c 'echo "db listening on 5432"; exec sleep 300'
Restart=on-failure
RestartSec=1
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
